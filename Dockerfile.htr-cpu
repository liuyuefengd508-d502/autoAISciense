# CPU-only Docker image for AI-Scientist running the htr_baseline template.
# Avoids texlive-full to keep the image small and fast to build; uses a smaller
# texlive subset that is still sufficient for the LaTeX templates produced by
# AI-Scientist.
FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# System deps:
#  - texlive-* + chktex: needed by perform_writeup
#  - latexmk: convenient pdflatex driver
#  - git, build-essential: aider / pip builds
#  - libgl1, libglib2.0-0: needed by Pillow/torchvision in slim image
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        build-essential \
        ca-certificates \
        wget \
        latexmk \
        chktex \
        texlive-latex-base \
        texlive-latex-extra \
        texlive-latex-recommended \
        texlive-fonts-recommended \
        texlive-fonts-extra \
        texlive-science \
        texlive-bibtex-extra \
        biber \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install CPU-only PyTorch first (smaller, avoids CUDA dependency download).
RUN pip install --upgrade pip \
    && pip install --index-url https://download.pytorch.org/whl/cpu \
        torch==2.4.0 torchvision==0.19.0

# AI-Scientist requirements (mirrors requirements.txt, pinned for reproducibility)
RUN pip install \
        anthropic==0.34.0 \
        aider-chat==0.50.1 \
        backoff==2.2.1 \
        openai==1.40.6 \
        google-generativeai==0.7.2 \
        matplotlib==3.9.2 \
        pypdf==4.3.1 \
        pymupdf4llm==0.0.10 \
        numpy==1.26.4 \
        transformers==4.44.0 \
        datasets==2.21.0 \
        tiktoken==0.7.0 \
        wandb==0.17.7 \
        tqdm==4.66.5

# HTR-specific extras
RUN pip install \
        editdistance==0.8.1 \
        jiwer==3.0.4 \
        python-Levenshtein==0.25.1 \
        pyalex==0.15.1 \
        Pillow==10.4.0

# The repo will be bind-mounted at /workspace at runtime.
WORKDIR /workspace

# Default to an interactive shell so the user can run prepare/experiment/launch
# commands manually. API keys are passed via -e at `docker run`.
CMD ["bash"]
