# CPU-only Docker image for AI-Scientist running the htr_baseline template.
# Avoids texlive-full to keep the image small and fast to build; uses a smaller
# texlive subset that is still sufficient for the LaTeX templates produced by
# AI-Scientist.
FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# System deps:
#  - texlive-* + chktex: needed by perform_writeup
#  - latexmk: convenient pdflatex driver
#  - git, build-essential: aider / pip builds
#  - libgl1, libglib2.0-0: needed by Pillow/torchvision in slim image
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        build-essential \
        ca-certificates \
        wget \
        latexmk \
        chktex \
        texlive-latex-base \
        texlive-latex-extra \
        texlive-latex-recommended \
        texlive-fonts-recommended \
        texlive-fonts-extra \
        texlive-science \
        texlive-bibtex-extra \
        biber \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install CPU-only PyTorch first (smaller, avoids CUDA dependency download).
RUN pip install --upgrade pip \
    && pip install --index-url https://download.pytorch.org/whl/cpu \
        torch==2.4.0 torchvision==0.19.0

# AI-Scientist requirements. We bump `openai` and `aider-chat` above the
# pinned versions in requirements.txt so the new OpenAI **Responses API**
# (used by reasoning-style models such as `gpt-5.4` exposed via the
# shareapi.cloud proxy) is supported.
# aider-chat pins lots of transitive deps. Install it first in isolation so
# the resolver picks aider's preferred versions, then layer the
# AI-Scientist extras on top.
RUN pip install aider-chat==0.85.1
RUN pip install \
        anthropic==0.42.0 \
        backoff==2.2.1 \
        google-generativeai==0.8.5 \
        matplotlib==3.9.2 \
        pypdf==4.3.1 \
        pymupdf4llm==0.0.10 \
        "numpy<2.0" \
        transformers \
        datasets \
        wandb

# HTR-specific extras
RUN pip install \
        editdistance==0.8.1 \
        jiwer==3.0.4 \
        python-Levenshtein==0.25.1 \
        pyalex==0.15.1 \
        Pillow==10.4.0

# The repo will be bind-mounted at /workspace at runtime.
WORKDIR /workspace

# Default to an interactive shell so the user can run prepare/experiment/launch
# commands manually. API keys are passed via -e at `docker run`.
CMD ["bash"]
